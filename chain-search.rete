-- An automatically parallel search for minimal-length addition chains (MLACs).

-- Keep the lines at 80 columns or lesse; reflow if necessary.

#ifndef TARGET
#define TARGET 100000003
#endif

#ifndef LEVEL
#define LEVEL 29
#endif

#define CEILDIV(a, b) (((a) - 1u64) / (b) + 1u64)

#define POW2(e) (1u64 << ($oftype 0u64 (e)))

data List a = Nil | Cons a (List a);

data State =
    State
    (List "an unsigned 64-bit chain element")
    "an unsigned 64-bit remaining depth"
    "a string of packed vertical bounds"
    "a string of packed slant bounds";

data Exhausted = Exhausted;

target = TARGET/**/u64;

level = LEVEL/**/u64;

main =
    let st = State (Cons 1u64 Nil) level (bounds vertical) (bounds slant) in
    case search st of { Exhausted -> "No solution" };

render elems =
    case elems of {
        Nil -> $panic "Empty addition chain impossible";
        Cons x xs -> case xs of {
            Nil -> $show x;
            Cons _ _ -> renderAux xs ++ $show x
        }
    };

renderAux elems =
    case elems of {
        Nil -> "";
        Cons x xs -> renderAux xs ++ $show x ++ " "
    };

search st =
    let State elems nremaining verticalBounds slantBounds = st in
    let Cons top rest = elems in
    -- If the target is found, terminate the program immediately.
    if top == target
    then $panic (render elems)
    -- Vertical pruning.
    else if top < $read64 verticalBounds nremaining
    then Exhausted
    else case rest of {
        -- Slant pruning.
        Cons penultimate _
            | top + penultimate < $read64 slantBounds nremaining
                && top * (1u64 << nremaining) != target ->
                    Exhausted;
        Cons _ _ -> expand st;
        Nil -> expand st
    };

expand st =
    let State elems nremaining _ _ = st in
    let Cons top _ = elems in
    -- There is at least one shortest addition chain for a given target that has
    -- four terminal star steps [2].
    if nremaining <= 4u64
    then stars st top elems
    else pairs st top elems;

pairs st top elems =
    case elems of {
        Nil -> Exhausted;
        Cons x xs -> sums st top x elems xs
    };

sums st top x elems pending =
    case elems of {
        Nil -> pairs st top pending;
        Cons y ys | x + y <= top -> sums st top x ys pending;
        Cons y ys | x + y > target -> sums st top x ys pending;
        Cons y ys -> join (proceed st (x + y)) (sums st top x ys pending)
    };

-- Same as `sums`, except specialized to the four terminal star steps [2].
stars st top elems =
    case elems of {
        Nil -> Exhausted;
        Cons y ys | top + y > target -> stars st top ys;
        Cons y ys -> join (proceed st (top + y)) (stars st top ys)
    };

-- `join a b` is strict in both `a` & `b`, which lets the engine parallelize
-- their evaluation at call sites.
join a b =
    case a of { Exhausted -> b };

proceed st candidate =
    let State elems nremaining verticalBounds slantBounds = st in
    let st' =
        State
        (Cons candidate elems)
        (nremaining - 1u64)
        verticalBounds
        slantBounds
    in
    search st';

bounds sequence =
    goBounds sequence 0u64;

goBounds sequence i =
    if i > level
    then ""
    else $prepend64 (goBounds sequence (i + 1u64)) (sequence i);

-- Theorem 1 concerning sequence F in Section "4. Lower Bounds" from [1].
vertical nremaining =
    let n = target in
    let lb = $oftype 0i64 level in
    let i = lb - $oftype 0i64 nremaining in
    let t = $oftype 0i64 ($ctz n) in
    if lb - t - 1i64 <= i && i <= lb
    then CEILDIV(n, POW2(lb - i))
    else if i == lb - t - 2i64
    then CEILDIV(n, POW2(t) * (POW2(lb - t - (i + 1i64)) + 1u64))
    else if 0i64 <= i && i <= lb - t - 3i64
        && n % (POW2(lb - t - i - 2i64) + 1u64) != 0u64
    then CEILDIV(n, POW2(t) * (POW2(lb - t - (i + 1i64)) + 1u64))
    else if 0i64 <= i && i <= lb - t - 3i64
        && n % (POW2(lb - t - i - 2i64) + 1u64) == 0u64
    then CEILDIV(n, POW2(t + 1i64) * (POW2(lb - t - (i + 2i64)) + 1u64))
    else $panic "Unreachable in `vertical`";

-- Theorem 2 concerning sequence G in Section "4. Lower Bounds" from [1].
slant nremaining =
    let n = target in
    let lb = $oftype 0i64 level in
    let i = lb - $oftype 0i64 nremaining + 1i64 in
    let t = $oftype 0i64 ($ctz n) in
    if nremaining == 0u64
    then 666u64 -- the search finishes before reaching slant pruning
    else if lb - t <= i && i <= lb
    then CEILDIV(n, POW2(lb - i))
    else if 0i64 <= i && i <= lb - t - 1i64
        && n % (POW2(lb - t - i) + 1u64) != 0u64
    then CEILDIV(3u64 * n, POW2(t) * (POW2(lb - t - i + 1i64) + 1u64))
    else if 0i64 <= i && i <= lb - t - 1i64
        && n % (POW2(lb - t - i) + 1u64) == 0u64
    then CEILDIV(3u64 * n, POW2(t + 1i64) * (POW2(lb - t - i) + 1u64))
    else $panic "Unreachable in `slant`";

-- [1] Thurber, Edward G., and Neill M. Clift. "Addition chains, vector chains,
--     and efficient computation." Discrete Mathematics 344.2 (2021): 112200.
-- [2] Bahig, Hatem M. "Star reduction among minimal length addition chains."
--     Computing 91.4 (2011): 335-352.
