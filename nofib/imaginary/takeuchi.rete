-- No sharing, maximal parallelisme; ported from `imaginary/tak/Main.hs`.

#ifndef X
#define X 35
#endif

#ifndef Y
#define Y 18
#endif

#ifndef Z
#define Z 9
#endif

main =
    $show (tak X/**/i64 Y/**/i64 Z/**/i64);

tak x y z =
    if not (y < x)
    then z
    else tak (tak (x - 1i64) y z) (tak (y - 1i64) z x) (tak (z - 1i64) x y);
