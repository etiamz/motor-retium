-- Full sharing, substantial parallelisme; ported from `imaginary/queens/Main.hs`.

#ifndef N
#define N 10i64
#endif

Nil : 0;
Cons : 2;

main =
    nsoln N;

nsoln nq =
    length (gen nq nq);

gen nq n =
    if n == 0i64
    then Cons Nil Nil
    else
        concatMap
        (\b ->
            concatMap
            (\q -> if safe q 1i64 b then Cons (Cons q b) Nil else Nil)
            (enumFromTo 1i64 nq))
        (gen nq (n - 1i64));

safe x d board =
    case board of {
        Nil -> true;
        Cons q l -> x != q && x != q + d && x != q - d && safe x (d + 1i64) l
    };

concatMap f xs =
    case xs of { Nil -> Nil; Cons x xs -> append (f x) (concatMap f xs) };

append xs ys =
    case xs of { Nil -> ys; Cons x xs -> Cons x (append xs ys) };

enumFromTo n m =
    if n > m then Nil else Cons n (enumFromTo (n + 1i64) m);

length xs =
    case xs of { Nil -> 0u64; Cons _ xs -> 1u64 + length xs };
